# The "files" field in package.json is the whitelist for what gets published
# (dist, README.md, LICENSE, NOTICE, plus package.json). npm ignores this root
# .npmignore while "files" is set; it only applies if "files" is removed.
# CI (the pack job) fails if the tarball contains anything else.

# Sources and build config
src/
scripts/
tsconfig.json
jest.config.js
*.tsbuildinfo

# Docs and examples (README.md is the only documentation shipped)
docs/
examples/
CONTRIBUTING.md
SECURITY.md

# Tests
tests/
coverage/
__tests__/
*.test.ts
*.spec.ts
test-*.js
test-*.ts

# Repository and tooling
.git/
.github/
.gitignore
.claude/
.vscode/
.idea/

# Secrets and local files
.env
.env.*
*.log
*.tgz
.DS_Store
Thumbs.db
